# ---- Server ----
# Port the Express server listens on (cloud platforms usually set this automatically)
PORT=3000

# Base public URL of the deployed app, used to build the OAuth callback URL.
# Local development example: http://localhost:3000
# Deployed example:          https://your-app.onrender.com
APP_BASE_URL=http://localhost:3000

# ---- Application JWT ----
# Secret used to sign/verify the application JWT. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# ---- GitHub OAuth (recommended) ----
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be:  <APP_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ---- Cookie behaviour ----
# Set to "true" in production (HTTPS). When false, the cookie is not marked Secure
# so it still works over plain http://localhost during local development.
COOKIE_SECURE=false
